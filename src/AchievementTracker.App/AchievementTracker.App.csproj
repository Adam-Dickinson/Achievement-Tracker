<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AchievementTracker.App</RootNamespace>
    <AssemblyName>AchievementTracker</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Achievement Tracker desktop app</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AchievementTracker.Core\AchievementTracker.Core.csproj" />
    <ProjectReference Include="..\AchievementTracker.Store\AchievementTracker.Store.csproj" />
    <ProjectReference Include="..\AchievementTracker.Providers\AchievementTracker.Providers.csproj" />
    <ProjectReference Include="..\AchievementTracker.Sync\AchievementTracker.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
