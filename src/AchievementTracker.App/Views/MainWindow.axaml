<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AchievementTracker.App.ViewModels"
        x:Class="AchievementTracker.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Achievement Tracker"
        Icon="/Assets/app-icon.ico"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource OnPrimaryBrush}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource FgBrush}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="240,*">
    <Border Background="{StaticResource Surface1Brush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="4,4,0,24">
          <Path Data="{StaticResource TrophyGeometry}"
                Fill="{StaticResource PrimaryBrush}"
                Stretch="Uniform"
                Width="20"
                Height="24" />
          <TextBlock Text="Achievement Tracker"
                     FontSize="16"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="4,0,0,4">
          <Ellipse Width="8"
                   Height="8"
                   Fill="{StaticResource SuccessBrush}"
                   VerticalAlignment="Center" />
          <TextBlock Text="{Binding SyncStatus}"
                     FontSize="12"
                     Foreground="{StaticResource FgMutedBrush}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <StackPanel Grid.Column="1"
                Margin="32"
                Spacing="8">
      <TextBlock Text="{Binding SelectedNav.Title}"
                 FontSize="28"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedNav.Description}"
                 Foreground="{StaticResource FgMutedBrush}" />
      <TextBlock Text="Scaffold ready. Screens are built milestone by milestone: see docs/ROADMAP.md."
                 Margin="0,24,0,0"
                 Foreground="{StaticResource FgSubtleBrush}" />
      <Button Classes="primary"
              Content="Send test notification"
              Command="{Binding SendTestNotificationCommand}"
              HorizontalAlignment="Left"
              Margin="0,8,0,0" />
    </StackPanel>
  </Grid>
</Window>
