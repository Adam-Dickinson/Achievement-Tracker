<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AchievementTracker.App.ViewModels"
             x:Class="AchievementTracker.App.Views.ToastView"
             x:DataType="vm:ToastViewModel"
             Width="380"
             Height="96">
  <!-- Spec: .superdesign/design-system.md ("Unlock toast"). Mockup: docs/design/mockups/unlock-toast.html -->

  <UserControl.Styles>
    <!-- Each rarity tier redefines ToastAccent; everything inside the toast reads that one resource. -->
    <Style Selector="Border.toast">
      <Style.Resources>
        <SolidColorBrush x:Key="ToastAccent" Color="{StaticResource RarityCommonColor}" />
      </Style.Resources>
      <Setter Property="BoxShadow" Value="{StaticResource ToastShadow}" />
    </Style>
    <Style Selector="Border.toast.uncommon">
      <Style.Resources>
        <SolidColorBrush x:Key="ToastAccent" Color="{StaticResource RarityUncommonColor}" />
      </Style.Resources>
    </Style>
    <Style Selector="Border.toast.rare">
      <Style.Resources>
        <SolidColorBrush x:Key="ToastAccent" Color="{StaticResource RarityRareColor}" />
      </Style.Resources>
    </Style>
    <Style Selector="Border.toast.ultra">
      <Style.Resources>
        <SolidColorBrush x:Key="ToastAccent" Color="{StaticResource RarityUltraColor}" />
      </Style.Resources>
      <Setter Property="BoxShadow" Value="{StaticResource UltraToastShadow}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="toast"
          Classes.uncommon="{Binding IsUncommon}"
          Classes.rare="{Binding IsRare}"
          Classes.ultra="{Binding IsUltraRare}"
          Background="#F5181C25"
          BorderBrush="{DynamicResource ToastAccent}"
          BorderThickness="1"
          CornerRadius="{StaticResource PanelRadius}"
          Padding="16">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Width="64"
              Height="64"
              Background="{StaticResource Surface3Brush}"
              BorderBrush="{DynamicResource ToastAccent}"
              BorderThickness="2"
              CornerRadius="{StaticResource CardRadius}">
        <Path Data="{StaticResource TrophyGeometry}"
              Fill="{DynamicResource ToastAccent}"
              Stretch="Uniform"
              Width="28"
              Height="28"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
      </Border>

      <StackPanel Grid.Column="1"
                  Margin="12,0"
                  VerticalAlignment="Center"
                  Spacing="1">
        <TextBlock Text="ACHIEVEMENT UNLOCKED"
                   FontSize="11"
                   FontWeight="SemiBold"
                   LetterSpacing="0.6"
                   Foreground="{DynamicResource ToastAccent}" />
        <TextBlock Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FgBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Description}"
                   FontSize="12"
                   Foreground="{StaticResource FgMutedBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}"
                   FontSize="12"
                   Foreground="{StaticResource FgSubtleBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right">
        <TextBlock Text="{Binding RarityLabel}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   Foreground="{DynamicResource ToastAccent}" />
        <TextBlock Text="{Binding PercentText}"
                   FontSize="12"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource FgMutedBrush}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
