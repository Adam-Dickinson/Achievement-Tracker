{
  "name": "trophy-locker",
  "private": true,
  "version": "1.0.2",
  "author": "Adam Dickinson",
  "description": "Tracks achievements and trophies across platforms and emulators, with unlock pop-ups",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "build": {
    "appId": "io.github.adam-dickinson.trophy-locker",
    "productName": "Trophy Locker",
    "copyright": "Copyright (c) 2026 Adam Dickinson",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/tray.png",
      "resources/tray@2x.png",
      "resources/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Trophy Locker",
      "artifactName": "Trophy-Locker-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Adam-Dickinson",
      "repo": "Achievement-Tracker",
      "releaseType": "draft"
    }
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check src \"*.{ts,mjs,json}\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
