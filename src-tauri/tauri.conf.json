{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Achievement Tracker",
  "version": "0.1.0",
  "identifier": "dev.achievementtracker.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Achievement Tracker",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      },
      {
        "label": "overlay",
        "title": "Achievement Tracker Overlay",
        "url": "overlay.html",
        "width": 420,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
