# --- Rust / Cargo ---
target/
**/*.rs.bk
# Cargo.lock IS committed (this is an application, not a library)

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
.pnpm-store/
*.tsbuildinfo
coverage/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri ---
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
# Generated TS bindings are committed; build artifacts are not
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.nsis.zip
*.sig

# --- Local data & secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json
# Local dev databases and sync caches
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.data/
# Recorded provider responses may contain real account data; only sanitized fixtures belong in git
tests/fixtures/_raw/

# --- Logs ---
*.log
logs/

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code (personal/local only) ---
.claude/settings.local.json
.claude/scratch/

# --- Superdesign ---
.superdesign/tmp/
